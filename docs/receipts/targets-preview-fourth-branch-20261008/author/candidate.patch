+def _preview_targets(args) -> int:
+    """Print the native selector's result without starting generation or tests."""
+    try:
+        if args.diff == "-":
+            diff_text = sys.stdin.read()
+        elif args.diff:
+            diff_text = Path(args.diff).read_text(encoding="utf-8")
+        else:
