    "import sys,unittest,json;sys.path.insert(0,'tests');import test_history;from testpilot import history\noriginal=history.os.fdopen;observed=[]\ndef raw(*args,**kwargs):\n if kwargs.get('buffering') != 0: raise RuntimeError('read wrapper permits buffering')\n observed.append(kwargs['buffering']);return original(*args,**kwargs)\nhistory.os.fdopen=raw\nsuite=unittest.TestSuite(test_history.HistoryTests(n) for n in ['test_byte_limit_exact_boundary_and_global_overflow_count', 'test_per_file_limit_precedes_global_and_keeps_later_siblings', 'test_invalid_bodies_use_global_budget_before_filters', 'test_size_change_is_a_read_problem_and_keeps_acquired_bytes'])\nresult=unittest.TextTestRunner(verbosity=2).run(suite)\nprint(json.dumps({'raw_file_opens':len(observed),'buffering_values':observed,'passed':result.wasSuccessful()}))\nraise SystemExit(0 if result.wasSuccessful() and observed else 1)\n"
